#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir> <env-dir>

# fail fast
set -e

# clean up leaking environment
unset GIT_DIR



s3simple() {
	local command="$1"
	local url="$2"
	local file="${3:--}"

	if [ "${url:0:5}" != "s3://" ]; then
		echo "Need an s3 url"
		return 1
	fi
	local path="${url:5}"

	if [ -z "${AWS_ACCESS_KEY_ID-}" ]; then
		echo "Need AWS_ACCESS_KEY_ID to be set"
		return 1
	fi

	if [ -z "${AWS_SECRET_ACCESS_KEY-}" ]; then
		echo "Need AWS_SECRET_ACCESS_KEY to be set"
		return 1
	fi

	local method md5 args
	case "$command" in
	get)
		method="GET"
		md5=""
		args=(-o "$file")
		;;
	head)
		method="HEAD"
		md5=""
		args=(-I)
		;;
	put)
		method="PUT"
		if [ ! -f "$file" ]; then
			echo "file not found"
			exit 1
		fi
		md5="$(openssl md5 -binary "$file" | openssl base64)"
		args=(-T "$file" -H "Content-MD5: $md5")
		;;
	*)
		echo "Unsupported command"
		return 1
		;;
	esac

	local aws_headers=""
	if [ -n "${AWS_SESSION_TOKEN-}" ]; then
		args=("${args[@]}" -H "x-amz-security-token: ${AWS_SESSION_TOKEN}")
		aws_headers="x-amz-security-token:${AWS_SESSION_TOKEN}\n"
	fi

	local date
	date="$(date -u '+%a, %e %b %Y %H:%M:%S +0000')"

	local string_to_sign
	printf -v string_to_sign "%s\n%s\n\n%s\n%b%s" "$method" "$md5" "$date" "$aws_headers" "/$path"

	local signature
	signature=$(echo -n "$string_to_sign" | openssl sha1 -binary -hmac "${AWS_SECRET_ACCESS_KEY}" | openssl base64)

	local authorization="AWS ${AWS_ACCESS_KEY_ID}:${signature}"

	local bucket="${path%%/*}"
	local key="${path#*/}"

	curl "${args[@]}" -s -f -H "Date: ${date}" -H "Authorization: ${authorization}" "https://${bucket}.s3.amazonaws.com/${key}"
}

# LIBREOFFICE_URL="https://appimages.libreitalia.org/portable/LibreOffice-7.3.4.2.basic-x86_64.AppImage"


FILE_NAME="LibreOffice-7.2.5-x86_64.AppImage"

BUILD_DIR=$1
ENV_DIR=$3
BUILDPACK_DIR="$(dirname $(dirname $0))"
INSTALL_DIR="/app/libreoffice"
TMP_DIR=$(mktemp -d)

echo "-----> Downloading LibreOffice"
# curl --silent --show-error --fail -L -o "${TMP_DIR}/${FILE_NAME}" "${LIBREOFFICE_URL}"
S3_KEY=$(cat ${ENV_DIR}/AWS_S3_ACCESS_KEY)
echo $S3_KEY

# aws s3 cp s3://libreoffice7342/LibreOffice-7.3.4.2.basic-x86_64.AppImage "${TMP_DIR}/${FILE_NAME}"
s3simple get s3://libreoffice7342/LibreOffice-7.3.4.2.basic-x86_64.AppImage "${TMP_DIR}/${FILE_NAME}"

echo "-----> Extracting LibreOffice"
mkdir -p "${BUILD_DIR}/libreoffice"

if [[ "${BUILD_DIR}" != /app ]]; then
  mkdir -p /app
  ln -nsf "${BUILD_DIR}/libreoffice" "${INSTALL_DIR}"
  ln -nsf "${BUILD_DIR}/vendor" /app/vendor
fi

cd $TMP_DIR
chmod a+x $FILE_NAME
./$FILE_NAME --appimage-extract
cd ..

cp -R $TMP_DIR/squashfs-root/usr $INSTALL_DIR
cp -R $TMP_DIR/squashfs-root/opt $INSTALL_DIR

rm -rf "${TMP_DIR}"

echo "-----> Successfully extracted LibreOffice"

echo "-----> Set .profile.d"

PROFILE_PATH="$BUILD_DIR/.profile.d/libreoffice.sh"
RUNTIME_INSTALL_PATH="\$HOME/libreoffice"
mkdir -p $(dirname $PROFILE_PATH)
INSTALLED_VERSION=$(ls $INSTALL_DIR/opt)
echo "export PATH=$RUNTIME_INSTALL_PATH/opt/$INSTALLED_VERSION/program:\$PATH" >> $PROFILE_PATH
echo "export OFFICE_PATH=$RUNTIME_INSTALL_PATH/opt/$INSTALLED_VERSION" >> $PROFILE_PATH
echo "chmod 777 -R /app/libreoffice" >> $PROFILE_PATH

chmod +x $BUILD_DIR/.profile.d/libreoffice.sh

echo "-----> LibreOffice installation done"
